{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodePulse",
  "version": "2.3.8",
  "identifier": "com.codepulse.app",
  "build": {
    "runner": {
      "cmd": "cargo",
      "args": ["--bin", "codepulse"]
    },
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build && pnpm run build:codex-bridge",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "CodePulse 控制台",
        "width": 760,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "maximized": false,
        "maximizable": false,
        "label": "main",
        "url": "/",
        "visible": false
      },
      {
        "title": "CodePulse Widget",
        "width": 210,
        "height": 36,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "maximized": false,
        "maximizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "label": "widget",
        "url": "/widget"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "target/release/codepulse-codex-bridge.exe": "codepulse-codex-bridge.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
